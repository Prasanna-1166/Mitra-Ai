# Frontend settings (copy to .env.local). Everything with a VITE_ prefix is bundled
# into the public JavaScript: NEVER put a service-role key, an upstream AI key or any
# other secret here. Server-side secrets go in Supabase (see supabase/.env.example).

# From the Supabase dashboard: Project Settings -> API (Project URL)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# From the Supabase dashboard: Project Settings -> API Keys -> "Publishable key"
# (sb_publishable_...) or the legacy "anon" key. Safe in the browser ONLY because
# row-level security protects every table.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional UX tuning (the server enforces its own limits)
# VITE_CONNECT_TIMEOUT_MS=12000
# VITE_IDLE_TIMEOUT_MS=60000
# VITE_MAX_MESSAGE_CHARS=8000
# VITE_GUEST_CONTEXT_MESSAGES=20
