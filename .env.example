# Copy to .env (or .env.local) to override the defaults. All values are optional.
#
# IMPORTANT: every VITE_* variable is bundled into the public JavaScript that is
# sent to browsers. Never put API keys, tokens or other secrets here. If the AI
# provider ever requires a private credential, call it from a server-side proxy.

# WebSocket endpoint of the AI chat service (default shown)
VITE_AI_WS_URL=wss://backend.buildpicoapps.com/api/chatbot/chat

# Application identifier sent with every request (default shown)
VITE_AI_APP_ID=college-wife

# System prompt sent with every request (optional; a built-in default is used when empty)
# VITE_AI_SYSTEM_PROMPT=You are Mitra AI, a friendly, intelligent, and helpful AI assistant.

# Milliseconds to wait for the socket to open / for the provider to send the next chunk
VITE_AI_CONNECT_TIMEOUT_MS=10000
VITE_AI_IDLE_TIMEOUT_MS=45000
