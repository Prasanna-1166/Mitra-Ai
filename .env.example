# ==============================================================================
# Mitra AI — Frontend Environment Variables (Browser-Visible)
# ==============================================================================
# Copy this file to .env.local for local development.
# Everything with a VITE_ prefix is bundled into the public client JavaScript!
# NEVER put a Supabase service-role key, private AI key, or private secret here.
# Server-side secrets belong in Supabase (see supabase/.env.example).
# ==============================================================================

# [REQUIRED] Supabase Project URL (Browser-Visible)
# Format: https://<project-ref>.supabase.co
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://rpxzitasxocfffxrpojx.supabase.co

# [REQUIRED] Supabase Publishable API Key (Browser-Visible)
# Format: sb_publishable_... or legacy anon JWT
# Safe in the browser because Row-Level Security (RLS) protects all database tables.
# Found in: Supabase Dashboard -> Project Settings -> API Keys -> Publishable key
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xNwdNLeMnnjQNkInIgk0CQ_jTAcoQX8

# [OPTIONAL] Frontend UX Tuning (the server strictly enforces its own limits)
# VITE_CONNECT_TIMEOUT_MS=12000
# VITE_IDLE_TIMEOUT_MS=60000
# VITE_MAX_MESSAGE_CHARS=8000
# VITE_GUEST_CONTEXT_MESSAGES=20
