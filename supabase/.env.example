# Server-side configuration for the Edge Functions. Set it with:
#   supabase secrets set --env-file supabase/.env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically;
# do NOT put the service-role key in any file you commit, and never in VITE_ variables.

# --- usage policy (product defaults shown) ---
GUEST_PROMPT_LIMIT=5          # questions a guest session may ask in total
USER_DAILY_LIMIT=100          # questions per signed-in user per UTC day
GUEST_SESSION_DAYS=30         # guest session lifetime
REQUESTS_PER_MINUTE=8         # per user / guest session
GUEST_SESSIONS_PER_IP_PER_DAY=20

# --- request / context bounds ---
MAX_MESSAGE_CHARS=8000
CONTEXT_MAX_MESSAGES=20
CONTEXT_MAX_CHARS=12000
MEMORY_MAX_ITEMS=12
MEMORY_MAX_CHARS=2000

# --- upstream AI provider ---
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
AI_UPSTREAM_WS_URL=wss://backend.buildpicoapps.com/api/chatbot/chat
AI_UPSTREAM_APP_ID=college-wife
UPSTREAM_CONNECT_TIMEOUT_MS=10000
UPSTREAM_IDLE_TIMEOUT_MS=45000
TOTAL_TIMEOUT_MS=110000

# --- security ---
# Comma-separated browser origins allowed to open the relay and call the functions.
ALLOWED_ORIGINS=http://localhost:5173,https://ai.prasanna.tech,https://*.netlify.app,https://your-app.example.com
# Random secret used to hash IP addresses for guest-session throttling (never stored in clear).
IP_HASH_SALT=change-me-to-a-long-random-string
